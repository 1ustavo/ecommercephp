# Copie para .env e ajuste os valores.

APP_ENV=development
APP_URL=http://localhost/php

# PostgreSQL
DB_HOST=localhost
DB_NAME=ecommercephp
DB_USER=postgres
DB_PASS=

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# false = grava em storage/emails.log (útil em dev)
MAIL_ENABLED=false
MAIL_FROM=no-reply@ecoshop.com.br
MAIL_FROM_NAME=EcoShop

# SMTP (PHPMailer) — opcional; se MAIL_HOST estiver vazio, usa mail() do PHP
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SECURE=tls

# Fila de e-mails: em production os e-mails transacionais vão para storage/queue/
# e são enviados pelo worker (database/queue_worker.php).
# true = envia na hora, sem fila (útil se não quiser rodar o cron em dev/staging)
MAIL_QUEUE_SYNC=false

# ---------------------------------------------------------------------------
# Pagamentos (opcional)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Correios (frete) — opcional
# ---------------------------------------------------------------------------
CORREIOS_USUARIO=
CORREIOS_SENHA=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CEP_ORIGEM=
